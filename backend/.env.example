DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

SQLITE_DB_PATH=db.sqlite3

# In local debug mode, Celery tasks run synchronously without a Redis service.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
OPEN_METEO_TIMEOUT=20

# Optional: set before running seed_demo to set passwords on newly created demo accounts.
DEMO_USER_PASSWORD=

SMS_PROVIDER=simulator
VENDEL_BASE_URL=https://app.vendel.cc
VENDEL_API_KEY=
# Shared signing secret, not a URL. Set the same value in Vendel's webhook configuration.
VENDEL_WEBHOOK_SECRET=
# Local callback URL: http://127.0.0.1:8000/api/sms/vendel/webhook/
# Vendel needs a public HTTPS tunnel URL to reach a local development server.
DEMO_RECIPIENTS=
